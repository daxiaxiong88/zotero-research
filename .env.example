# Zotero Local API is intentionally restricted to the official loopback endpoint.
ZRM_ZOTERO_BASE_URL=http://127.0.0.1:23119/api/

# Optional OpenAI-compatible local model (Ollama/vLLM/etc.).
# ZRM_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# ZRM_MODEL_NAME=your-local-model
# ZRM_MODEL_TRUST=local
# ZRM_MODEL_API_KEY=

# Preview lifetime: 60 to 3600 seconds.
ZRM_NOTE_PREVIEW_TTL_SECONDS=600

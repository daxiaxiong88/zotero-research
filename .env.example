# Zotero 官方 Local API：仅允许 HTTP loopback、明确端口和 /api/ 路径。
# 默认端口是 23119；隔离测试 profile 可以改成另一个本机回环端口。
ZRM_ZOTERO_BASE_URL=http://127.0.0.1:23119/api/

# 可选本地 OpenAI 兼容模型。以下只是占位示例，不代表本机已有模型或推荐型号。
# 若实际启用，填写真实服务地址和已安装的模型名称；空白时保持“仅证据摘录”。
# ZRM_LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# ZRM_LOCAL_MODEL_NAME=your-installed-local-model

# 可选的另一套 OpenAI 兼容模型配置。BASE_URL 与 NAME 必须同时设置。
# 外部服务必须显式使用 external；密钥只放在本机 .env，不要提交。
# ZRM_MODEL_BASE_URL=填写实际 OpenAI 兼容地址
# ZRM_MODEL_NAME=your-configured-model
# ZRM_MODEL_TRUST=auto
# ZRM_MODEL_API_KEY=

# MinerU 本地重解析：只有配置完整 pipeline 模型目录后才启用；本轮没有权重。
# ZRM_MINERU_MODEL_PATH=
ZRM_MINERU_EXECUTABLE=mineru
ZRM_MINERU_TIMEOUT_SECONDS=600

# MCP 正文/证据/notes 的云端披露固定为本地授权 + 调用方显式 allow_cloud；没有 local 免授权配置。

# 可选状态目录；留空时使用代码中的 Windows LOCALAPPDATA 默认目录。
# ZRM_STATE_DIRECTORY=C:\absolute\path\ZoteroResearch

# 代码允许的模型超时和笔记预览有效期范围分别为 1–600 秒、60–3600 秒。
ZRM_MODEL_TIMEOUT_SECONDS=120
ZRM_NOTE_PREVIEW_TTL_SECONDS=600
